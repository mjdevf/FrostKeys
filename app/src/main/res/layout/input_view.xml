<helium314.keyboard.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true"
    android:clipToPadding="true">
    <include
        android:id="@+id/fakeToast"
        layout="@layout/fake_toast" />
    <include
        android:id="@+id/main_keyboard_frame"
        layout="@layout/main_keyboard_frame" />

    <!-- Gboard-style top corner resize handles (floating mode only — visibility is
         toggled from FloatingKeyboardUtils; in floating mode the InputView spans
         exactly the floating panel, so top|start / top|end land on the panel corners) -->
    <ImageView
        android:id="@+id/resize_handle_tl"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:padding="3dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_floating_corner"
        android:visibility="gone"
        android:contentDescription="@string/label_resize_onehanded_key" />

    <ImageView
        android:id="@+id/resize_handle_tr"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:padding="3dp"
        android:scaleType="fitXY"
        android:rotation="90"
        android:src="@drawable/ic_floating_corner"
        android:visibility="gone"
        android:contentDescription="@string/label_resize_onehanded_key" />

    <!-- Gboard-style top drag handle strip (floating mode only) -->
    <FrameLayout
        android:id="@+id/drag_handle_top"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:visibility="gone"
        android:contentDescription="@string/label_stop_onehanded_mode_key">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_floating_pill" />
    </FrameLayout>
</helium314.keyboard.latin.InputView>
